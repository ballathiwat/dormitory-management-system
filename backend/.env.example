# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://dorm_user:dorm_password@localhost:5432/dormitory_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Cache
REDIS_URL=redis://localhost:6379
REDIS_DB=0

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRATION=24h

# File Storage
STORAGE_TYPE=local
STORAGE_PATH=/data/uploads

# Minio (if using S3-like storage)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=dormitory

# Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# SMS Service (Thai provider)
SMS_GATEWAY=true
SMS_PROVIDER=truemove-api
SMS_API_KEY=your-api-key

# Payment Gateway
PAYMENT_GATEWAY=omise
OMISE_SECRET_KEY=your-omise-key

# Admin Credentials (first setup)
ADMIN_EMAIL=admin@dormitory.local
ADMIN_PASSWORD=ChangeMe123!@

# CORS
CORS_ORIGIN=http://localhost:3001,https://yourdomain.com

# API Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
